            DELETE FROM `global_property` WHERE (`property` = 'dqr_last_txcurr');
        </sql>
        
    </changeSet>
    
    <changeSet id="ref-create_conceptval_fn_notexist" author="from_DQR">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) 
                FROM information_schema.ROUTINES 
                WHERE ROUTINE_SCHEMA = DATABASE() 
                  AND ROUTINE_NAME = 'getconceptval' 
                  AND ROUTINE_TYPE = 'FUNCTION';
            </sqlCheck>
        </preConditions>
        <sql splitStatements="false" endDelimiter="$$">
            DELIMITER $$
            CREATE FUNCTION `getconceptval`(`obsid` INT, `cid` INT, `pid` INT) 
            RETURNS decimal(10,0)
            BEGIN
                DECLARE value_num INT;
                SELECT DISTINCT obs.value_numeric INTO value_num
                FROM obs
                WHERE obs.obs_group_id IS NOT NULL
                  AND obs.obs_group_id = obsid
                  AND obs.concept_id = cid
                  AND obs.person_id = pid
                  AND obs.voided = 0
                  AND obs.value_numeric IS NOT NULL
                ORDER BY obs_id ASC
                LIMIT 1;
                RETURN value_num;
            END$$
            DELIMITER ;
        </sql>
    </changeSet>


    
